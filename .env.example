BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
PAPER_TRADING=true
BYBIT_CATEGORY=linear
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAME=60
INITIAL_BALANCE=10000
RISK_PER_TRADE=0.005
DEFAULT_LEVERAGE=5
STOP_LOSS_PCT=0.005
TAKE_PROFIT_PCT=0.006
MAX_POSITION_NOTIONAL_PCT=2.0
BREAK_EVEN_TRIGGER_PCT=0.006
BREAK_EVEN_OFFSET_PCT=0.0005
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSS_BARS=4
MAX_OPEN_POSITIONS=3
POLL_INTERVAL_SECONDS=15
LOG_DIR=logs
TRADE_LOG_FILE=trades.jsonl
EVENT_LOG_FILE=bot.log
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_LONG_THRESHOLD=54
RSI_SHORT_THRESHOLD=46
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
TREND_EMA=50
ATR_PERIOD=14
ATR_MIN_PCT=0.0032
ADX_PERIOD=14
MIN_ADX=22
VOLUME_MA_PERIOD=20
MIN_VOLUME_RATIO=1.15
BREAKOUT_LOOKBACK=12
MIN_TREND_STRENGTH_PCT=0.001
SIGNAL_SCORE_THRESHOLD=5
EXTREME_ENTRY_MODE=true
MIN_EXPECTED_MOVE_PCT=0.004
MIN_SIGNAL_CONFIDENCE=0.62
REQUIRE_BREAKOUT_CONFIRMATION=true
PULLBACK_LOOKBACK=4
BREAKOUT_BUFFER_PCT=0.0004
ATR_STOP_MULTIPLE=1.0
ATR_TARGET_MULTIPLE=2.4
MAX_RSI_LONG=72
MIN_RSI_SHORT=28
MIN_BODY_TO_RANGE_RATIO=0.45
MIN_RANGE_WIDTH_PCT=0.004
EMA_RETEST_TOLERANCE_PCT=0.0035
REQUIRE_MACD_HIST_IMPROVING=true
COOLDOWN_BARS=2
FEE_RATE=0.0006
INVERT_SIGNALS=false
FILTER_SYMBOLS_BY_BACKTEST=true
BACKTEST_FILTER_CANDLES=3000
MIN_BACKTEST_PROFIT_FACTOR=1.35
MAX_BACKTEST_DRAWDOWN_PCT=25
MIN_BACKTEST_TRADES=20
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTH_ENABLED=false
AUTH_USERS_FILE=secrets/auth_users.json
AUTH_SESSION_MINUTES=480
AUTH_TOTP_ISSUER=Bybit Trading Bot
AUTH_AUDIT_LOG_FILE=auth_audit.jsonl
AUTH_COOKIE_SECRET=change-this-to-a-long-random-secret
AUTH_COOKIE_NAME=bybit_bot_session
APP_HOST=0.0.0.0
APP_PORT=8501
DASHBOARD_REFRESH_SECONDS=6
CONTROL_REFRESH_SECONDS=10
MOBILE_DEFAULT_VIEW=true

# --- transaction costs (Bybit linear VIP0 defaults) ---
MAKER_FEE_RATE=0.0002
TAKER_FEE_RATE=0.00055
ENTRY_SLIPPAGE_PCT=0.0002
EXIT_SLIPPAGE_PCT=0.0004
AUTO_SYNC_FEE_RATES=true

# --- post-only (maker) entries ---
MAKER_ENTRY_ENABLED=true
MAKER_ENTRY_TIMEOUT_BARS=1
MAKER_MAX_CHASE_PCT=0.0015
MAKER_ENTRY_FALLBACK=none

# --- cost-aware entry gate ---
MIN_TARGET_TO_COST_RATIO=4.0
MIN_NET_REWARD_RISK=1.5
REQUIRE_POSITIVE_EXPECTANCY=true

# --- exits ---
TAKE_PROFIT_MODE=fixed
TRAIL_ATR_MULTIPLE=1.5
MIN_BACKTEST_EXPECTANCY_R=0.05
REQUIRE_BACKTEST_APPROVAL=true
